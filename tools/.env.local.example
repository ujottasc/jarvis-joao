# Optional: a residential proxy, so each country's request leaves from that country.
# Copy to .env.local and fill in. Without it, requests go out from your own connection.
# The country is chosen by appending __cr.<code> to the username (DataImpulse format).
PROXY_HOST=gw.dataimpulse.com
PROXY_PORT=823
PROXY_USER=
PROXY_PASS=
